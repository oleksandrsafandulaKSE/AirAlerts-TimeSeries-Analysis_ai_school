{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "live-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=.env",
        "netlify/live/dev_server.mjs"
      ],
      "port": 8888
    },
    {
      "name": "live-offline",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "netlify/live/dev_server.mjs"
      ],
      "port": 8888
    },
    {
      "name": "live-offline-active",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DEV_M12_ACTIVE=1",
        "node",
        "netlify/live/dev_server.mjs"
      ],
      "port": 8888
    }
  ]
}
